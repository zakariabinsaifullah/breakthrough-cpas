{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "btcpa/timeline-item",
    "version": "1.0.0",
    "title": "Timeline Item",
    "category": "btcpa",
    "parent": ["btcpa/timeline"],
    "icon": "star-filled",
    "description": "Individual item for the timeline block.",
    "example": {},
    "supports": {
        "anchor": true,
        "html": false
    },
    "attributes": {
        "iconName": {
            "type": "string"
        },
        "iconType": {
            "type": "string",
            "default": "icon"
        },
        "customSvgCode": {
            "type": "string"
        },
        "iconSize": {
            "type": "number",
            "default": 32
        },
        "iconStyle": {
            "type": "string",
            "default": "solid"
        }
    },
    "textdomain": "breakthrough-cpas",
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css"
}
