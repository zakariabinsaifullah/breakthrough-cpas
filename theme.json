                    }
                },
                {
                    "fluid": false,
                    "name": "Heading Six",
                    "size": "18px",
                    "slug": "incc-heading-six"
                },
                {
                    "fluid": false,
                    "name": "Extra Large",
                    "size": "18px",
                    "slug": "incc-extra-large"
                },
                {
                    "fluid": false,
                    "name": "Large",
                    "size": "16px",
                    "slug": "incc-large"
                },
                {
                    "fluid": false,
                    "name": "Medium",
                    "size": "14px",
                    "slug": "incc-medium"
                },
                {
                    "fluid": false,
                    "name": "Small",
                    "size": "12px",
                    "slug": "incc-small"
                }
            ],
            "writingMode": true
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--incc-neutral-darkest)"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        }
                    },
                    "alternative": {
                        "border": {
                            "color": "var(--wp--preset--color--incc-navy-600)",
                            "radius": "100px",
                            "style": "solid",
                            "width": "2px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--incc-neutral-darkest)"
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--incc-navy-600)",
                                "text": "var(--wp--preset--color--incc-white)"
                            }
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--incc-neutral-lightest)",
                    "text": "var(--wp--preset--color--incc-neutral-darkest)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--incc-40)",
                        "left": "var(--wp--preset--spacing--incc-40)",
                        "right": "var(--wp--preset--spacing--incc-40)",
                        "top": "var(--wp--preset--spacing--incc-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--incc-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--incc-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--incc-neutral-dark)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--incc-neutral-dark)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--incc-30)",
                        "top": "var(--wp--preset--spacing--incc-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--incc-neutral-darkest)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--incc-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--incc-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--incc-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--incc-40)",
                        "top": "var(--wp--preset--spacing--incc-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--avenir-next)",
                    "fontSize": "var(--wp--preset--font-size--incc-large)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--incc-neutral-darker)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--incc-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--incc-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--incc-40)",
                        "top": "var(--wp--preset--spacing--incc-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--incc-neutral-dark)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--incc-neutral-dark)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)"
                }
            },
            "core/post-navigation-link": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)"
                }
            },
            "core/post-terms": {
                "css": "& a { white-space: nowrap; }",
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-small)",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "none"
                            }
                        },
                        "typography": {
                            "fontWeight": "400",
                            "lineHeight": "1.2",
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/pullquote": {
                "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--incc-30);}",
                "elements": {
                    "cite": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--incc-small)",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--incc-30)",
                        "top": "var(--wp--preset--spacing--incc-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-heading-four)",
                    "fontWeight": "300",
                    "lineHeight": "1.2"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-medium)",
                    "fontWeight": "500"
                }
            },
            "core/quote": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 0 2px"
                },
                "css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
                "elements": {
                    "cite": {
                        "css": "& sub { font-size: 0.65em }",
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--incc-small)",
                            "fontStyle": "normal",
                            "fontWeight": "300"
                        }
                    }
                },
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--incc-30)",
                    "margin": {
                        "left": "0",
                        "right": "0"
                    },
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--incc-30)",
                        "left": "var(--wp--preset--spacing--incc-40)",
                        "right": "var(--wp--preset--spacing--incc-40)",
                        "top": "var(--wp--preset--spacing--incc-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--incc-large)",
                    "fontWeight": "300"
                },
                "variations": {
                    "plain": {
                        "border": {
                            "color": "transparent",
                            "radius": "0",
                            "style": "none",
                            "width": "0"
                        },
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        }
                    }
                }
