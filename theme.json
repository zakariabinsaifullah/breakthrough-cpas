                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-500-normal.woff2"],
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-500-italic.woff2"],
                            "fontWeight": "500",
                            "fontStyle": "italic",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-600-normal.woff2"],
