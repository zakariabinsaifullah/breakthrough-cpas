        "layout": {
            "contentSize": "1280px",
            "wideSize": "1440px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Light Dark",
                    "shadow": "0px 5px 15px rgba(0, 0, 0, 0.4)",
                    "slug": "incc-light-dark"
                }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "Edge Gap",
                    "size": "1rem",
                    "slug": "incc-edge-gap"
                },
                {
                    "name": "Elements Gap",
                    "size": "1.5rem",
                    "slug": "incc-elements-gap"
                },
                {
                    "name": "2X Small",
                    "size": "20px",
                    "slug": "incc-20"
                },
                {
                    "name": "Small",
                    "size": "30px",
                    "slug": "incc-30"
                },
                {
                    "name": "Medium",
                    "size": "40px",
                    "slug": "incc-40"
                },
                {
                    "name": "Regular",
                    "size": "clamp(30px, 5vw, 50px)",
                    "slug": "incc-50"
                },
                {
                    "name": "Large",
                    "size": "clamp(30px, 7vw, 70px)",
                    "slug": "incc-60"
                },
                {
                    "name": "X-Large",
                    "size": "clamp(70px, 7vw, 100px)",
                    "slug": "incc-100"
                },
                {
                    "name": "Section Padding",
                    "size": "clamp(70px, 10vw, 100px)",
                    "slug": "incc-section-padding"
                }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "Avenir Next",
                    "slug": "avenir-next",
                    "fontFamily": "\"Avenir Next\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-100-normal.woff2"],
                            "fontWeight": "100",
                            "fontStyle": "normal",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-100-italic.woff2"],
                            "fontWeight": "100",
                            "fontStyle": "italic",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
