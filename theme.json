                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-700-italic.woff2"],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-900-normal.woff2"],
                            "fontWeight": "900",
                            "fontStyle": "normal",
                            "fontFamily": "\"Avenir Next\""
                        },
                        {
                            "src": ["file:./assets/fonts/avenir-next/avenir-next-900-italic.woff2"],
                            "fontWeight": "900",
                            "fontStyle": "italic",
                            "fontFamily": "\"Avenir Next\""
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Display",
                    "size": "80px",
                    "slug": "incc-display",
                    "fluid": {
                        "min": "40px",
                        "max": "80px"
                    }
                },
                {
                    "name": "Heading One",
                    "size": "64px",
                    "slug": "incc-heading-one",
                    "fluid": {
                        "min": "36px",
                        "max": "64px"
                    }
                },
                {
                    "name": "Heading Two",
                    "size": "52px",
                    "slug": "incc-heading-two",
                    "fluid": {
                        "min": "30px",
                        "max": "52px"
                    }
                },
                {
                    "name": "Heading Three",
                    "size": "32px",
                    "slug": "incc-heading-three",
                    "fluid": {
                        "min": "26px",
                        "max": "32px"
                    }
                },
                {
                    "name": "Heading Four",
                    "size": "24px",
                    "slug": "incc-heading-four",
                    "fluid": {
                        "min": "21px",
                        "max": "24px"
                    }
                },
                {
                    "name": "Heading Five",
                    "size": "20px",
                    "slug": "incc-heading-five",
                    "fluid": {
                        "min": "18px",
